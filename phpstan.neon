includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	# Level 9 is the highest level
	level: max

	paths:
		- blocks/
		- entries/
		- src/
		- wp-seo.php

	# Legacy php/ classes and global wp_seo_* functions aren't analyzed
	# directly (see paths above), but src/ references them, so their
	# symbols need to be known.
	scanDirectories:
		- php/

	# WP_CLI::error() exits unless told not to, which no caller does.
	earlyTerminatingMethodCalls:
		WP_CLI:
			- error

#    ignoreErrors:
#        - '#PHPDoc tag @var#'
#
#    excludePaths:
#        - ./*/*/FileToBeExcluded.php
#
#    checkMissingIterableValueType: false
